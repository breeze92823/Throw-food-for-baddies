# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Optional: a local game server (the Colyseus backend, `npm start` there) to play against without
# the Bloxity matchmaker, e.g. ws://localhost:2567. Built games ignore it and always go through
# the matchmaker (Legion.SDK.net.resolveEndpoint). Unset + no SDK = offline play.
VITE_SERVER_URL=
